+    // ---------- Autonomous mode (works without Shizuku after a one-time grant) ----------
+
+    const val UNREADABLE = "\u0000unreadable"
+    private const val WSS = "android.permission.WRITE_SECURE_SETTINGS"
+
+    fun shizukuReady(): Boolean = isShizukuAvailable() && hasPermission()
+
+    /** True if the app holds WRITE_SECURE_SETTINGS (persists across reboots). */
+    fun hasDirectAccess(ctx: Context): Boolean =
+        ctx.checkSelfPermission(WSS) == PackageManager.PERMISSION_GRANTED
+
+    fun canRestore(ctx: Context): Boolean = hasDirectAccess(ctx) || shizukuReady()
+
+    /** One-time grant via Shizuku (shell identity). */
+    fun grantDirectAccess(ctx: Context): CommandResult =
+        executeCommand("pm grant ${ctx.packageName} $WSS")
+
+    fun readSetting(ctx: Context, ns: String, key: String): String? {
+        if (shizukuReady()) {
+            val r = executeCommand("settings get $ns '$key'")
+            if (r.exitCode == 0) {
+                return if (r.stdout != "null" && r.stdout.isNotEmpty()) r.stdout else null
+            }
+        }
+        return try {
+            val cr = ctx.contentResolver
+            when (ns) {
+                "secure" -> Settings.Secure.getString(cr, key)
+                "system" -> Settings.System.getString(cr, key)
+                "global" -> Settings.Global.getString(cr, key)
+                else -> UNREADABLE
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "Cannot read $ns:$key: ${e.message}")
+            UNREADABLE
+        }
+    }
+
+    fun writeSetting(ctx: Context, ns: String, key: String, value: String): Boolean {
+        if (hasDirectAccess(ctx)) {
+            try {
+                val cr = ctx.contentResolver
+                val ok = when (ns) {
+                    "secure" -> Settings.Secure.putString(cr, key, value)
+                    "system" -> Settings.System.putString(cr, key, value)
+                    "global" -> Settings.Global.putString(cr, key, value)
+                    else -> false
+                }
+                if (ok) return true
+            } catch (e: Exception) {
+                Log.w(TAG, "Direct write failed for $ns:$key: ${e.message}")
+            }
+        }
+        if (shizukuReady()) {
+            return executeCommand("settings put $ns '$key' '$value'").exitCode == 0
+        }
+        return false
+    }
+
     data class CommandResult(
         val exitCode: Int,
         val stdout: String,
         val stderr: String
     )
 }
+
+private fun newProcessCompat(cmd: Array<String>): Process {
+    val m = Shizuku::class.java.getDeclaredMethod(
+        "newProcess", Array<String>::class.java, Array<String>::class.java, String::class.java
+    )
+    m.isAccessible = true
+    return m.invoke(null, cmd, null, null) as Process
+}
