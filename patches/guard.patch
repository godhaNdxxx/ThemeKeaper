+package com.themekeeper.app
+
+import android.util.Log
+
+/**
+ * Keeps the system "Themes" app (com.android.thememanager) from running in
+ * the background, which is where HyperOS performs the third-party theme rollback.
+ * Requires Shizuku (shell identity). Foreground use of Themes is never touched.
+ */
+object ThemeGuard {
+
+    private const val TAG = "ThemeGuard"
+    const val PKG = "com.android.thememanager"
+
+    private var ticks = 0
+    @Volatile var stopCount = 0
+        private set
+
+    fun applyRestrictions(): Boolean {
+        if (!ShizukuHelper.shizukuReady()) return false
+        listOf(
+            "cmd appops set $PKG RUN_IN_BACKGROUND ignore",
+            "cmd appops set $PKG RUN_ANY_IN_BACKGROUND ignore",
+            "cmd appops set $PKG WAKE_LOCK ignore",
+            "am set-standby-bucket $PKG restricted",
+            "cmd jobscheduler cancel -u 0 $PKG"
+        ).forEach { run(it) }
+        Log.i(TAG, "Restrictions applied")
+        return true
+    }
+
+    fun removeRestrictions(): Boolean {
+        if (!ShizukuHelper.shizukuReady()) return false
+        listOf(
+            "cmd appops set $PKG RUN_IN_BACKGROUND allow",
+            "cmd appops set $PKG RUN_ANY_IN_BACKGROUND allow",
+            "cmd appops set $PKG WAKE_LOCK allow",
+            "am set-standby-bucket $PKG active"
+        ).forEach { run(it) }
+        Log.i(TAG, "Restrictions removed")
+        return true
+    }
+
+    /**
+     * Called periodically from the monitor service (background thread).
+     * Returns true if the Themes app was found running in background and stopped.
+     */
+    fun tick(): Boolean {
+        if (!ShizukuHelper.shizukuReady()) return false
+        if (ticks++ % 20 == 0) applyRestrictions()
+        if (isRunning() && !isForeground()) {
+            run("am force-stop $PKG")
+            run("cmd jobscheduler cancel -u 0 $PKG")
+            stopCount++
+            Log.i(TAG, "Themes app stopped in background ($stopCount)")
+            return true
+        }
+        return false
+    }
+
+    private fun isRunning(): Boolean {
+        val r = ShizukuHelper.executeCommand("ps -A -o NAME | grep -c '^$PKG'")
+        return (r.stdout.trim().toIntOrNull() ?: 0) > 0
+    }
+
+    private fun isForeground(): Boolean {
+        val r = ShizukuHelper.executeCommand(
+            "dumpsys activity activities | grep -E 'topResumedActivity|mResumedActivity' | head -n 3"
+        )
+        return r.stdout.contains(PKG)
+    }
+
+    private fun run(cmd: String) {
+        val r = ShizukuHelper.executeCommand(cmd)
+        if (r.exitCode != 0) Log.w(TAG, "$cmd -> ${r.exitCode} ${r.stderr}")
+    }
+}
